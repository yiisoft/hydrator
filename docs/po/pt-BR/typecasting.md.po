#. type: Title ##
#: guide/en/mapping.md guide/en/typecasting.md
#, no-wrap
msgid "Using attributes"
msgstr "Usando atributos"

#. type: Title #
#: guide/en/typecasting.md
#, no-wrap
msgid "Typecasting"
msgstr "Typecasting"

#. type: Plain text
#: guide/en/typecasting.md
msgid "When PHP types are defined in the class, type-casting automatically happens on object creation or hydration:"
msgstr "Quando os tipos PHP são definidos na classe, a conversão de tipo acontece automaticamente na criação ou hidratação do objeto:"

#. type: Fenced code block (php)
#: guide/en/typecasting.md
#, no-wrap
msgid ""
"final class Lock\n"
"{\n"
"    public function __construct(\n"
"        private string $name,\n"
"        private bool $isLocked\n"
"    ) {}\n"
"}\n"
"\n"
"$hydrator = new Hydrator();\n"
"$lock = $hydrator->create(Lock::class, ['name' => 'The lock', 'isLocked' => 1]);\n"
msgstr ""
"final class Lock\n"
"{\n"
"    public function __construct(\n"
"        private string $name,\n"
"        private bool $isLocked\n"
"    ) {}\n"
"}\n"
"\n"
"$hydrator = new Hydrator();\n"
"$lock = $hydrator->create(Lock::class, ['name' => 'The lock', 'isLocked' => 1]);\n"

#. type: Title ##
#: guide/en/typecasting.md
#, no-wrap
msgid "Tweaking type-casting"
msgstr "Ajustando a conversão de tipos"

#. type: Plain text
#: guide/en/typecasting.md
msgid "You can adjust type-casting by passing a type-caster to the hydrator:"
msgstr "Você pode ajustar a conversão de tipo passando um type-caster para o hidratador:"

#. type: Fenced code block (php)
#: guide/en/typecasting.md
#, no-wrap
msgid ""
"use Yiisoft\\Hydrator\\Hydrator;\n"
"use Yiisoft\\Hydrator\\TypeCaster\\CompositeTypeCaster;\n"
"use Yiisoft\\Hydrator\\TypeCaster\\PhpNativeTypeCaster;\n"
"use Yiisoft\\Hydrator\\TypeCaster\\HydratorTypeCaster;\n"
"\n"
"$typeCaster = new CompositeTypeCaster(\n"
"    new PhpNativeTypeCaster(),\n"
"    new HydratorTypeCaster(),\n"
");\n"
"$hydrator = new Hydrator($typeCaster);\n"
msgstr ""
"use Yiisoft\\Hydrator\\Hydrator;\n"
"use Yiisoft\\Hydrator\\TypeCaster\\CompositeTypeCaster;\n"
"use Yiisoft\\Hydrator\\TypeCaster\\PhpNativeTypeCaster;\n"
"use Yiisoft\\Hydrator\\TypeCaster\\HydratorTypeCaster;\n"
"\n"
"$typeCaster = new CompositeTypeCaster(\n"
"    new PhpNativeTypeCaster(),\n"
"    new HydratorTypeCaster(),\n"
");\n"
"$hydrator = new Hydrator($typeCaster);\n"

#. type: Plain text
#: guide/en/typecasting.md
msgid "The set above is what's used by default."
msgstr "O conjunto acima é o usado por padrão."

#. type: Plain text
#: guide/en/typecasting.md
msgid "Out of the box, the following type-casters are available:"
msgstr "Fora da caixa, os seguintes type-casters estão disponíveis:"

#. type: Bullet: '- '
#: guide/en/typecasting.md
msgid "`CompositeTypeCaster` allows combining multiple type-casters"
msgstr "`CompositeTypeCaster` permite combinar vários type-casters"

#. type: Bullet: '- '
#: guide/en/typecasting.md
msgid "`PhpNativeTypeCaster` casts based on PHP types defined in the class"
msgstr "`PhpNativeTypeCaster` baseados em tipos PHP definidos na classe"

#. type: Bullet: '- '
#: guide/en/typecasting.md
msgid "`HydratorTypeCaster` casts arrays to objects"
msgstr "`HydratorTypeCaster` converte arrays em objetos"

#. type: Bullet: '- '
#: guide/en/typecasting.md
msgid "`EnumTypeCaster` casts values to enumerations"
msgstr "`EnumTypeCaster` converte valores em enumerações"

#. type: Bullet: '- '
#: guide/en/typecasting.md
msgid "`NullTypeCaster` configurable type caster for casting `null`, empty string and empty array to `null`"
msgstr "`NullTypeCaster` type-casters configurável para converter `null`, string vazia e array vazio para `null`"

#. type: Bullet: '- '
#: guide/en/typecasting.md
msgid "`NoTypeCaster` does not cast anything"
msgstr "`NoTypeCaster` não faça nada"

#. type: Title ##
#: guide/en/typecasting.md
#, no-wrap
msgid "Your own type-casting"
msgstr "Sua própria conversão de tipo"

#. type: Plain text
#: guide/en/typecasting.md
msgid "You can define custom type-casters if needed:"
msgstr "Você pode definir type-casters personalizados, se necessário:"

#. type: Fenced code block (php)
#: guide/en/typecasting.md
#, no-wrap
msgid ""
"use Yiisoft\\Hydrator\\TypeCaster\\TypeCastContext;\n"
"use Yiisoft\\Hydrator\\TypeCaster\\TypeCasterInterface;\n"
"use Yiisoft\\Hydrator\\Result;\n"
"use Yiisoft\\Hydrator\\Hydrator;\n"
"use Yiisoft\\Hydrator\\TypeCaster\\CompositeTypeCaster;\n"
"\n"
"final class User\n"
"{\n"
"    public function __construct(\n"
"        private string $nickname\n"
"    )\n"
"    {\n"
"    }\n"
"    \n"
"    public function getNickName(): string\n"
"    {\n"
"        return $this->nickname;\n"
"    }\n"
"}\n"
"\n"
"final class NickNameTypeCaster implements TypeCasterInterface\n"
"{\n"
"    public function cast(mixed $value, TypeCastContext $context): Result\n"
"    {\n"
"        $type = $context->getReflectionType();\n"
"    \n"
"        if (\n"
"            $context->getReflection()->getName() === 'author'\n"
"            && $type instanceof ReflectionNamedType\n"
"            && $type->isBuiltin()\n"
"            && $type->getName() === 'string'\n"
"            && preg_match('~^@(.*)$~', $value, $matches)\n"
"        ) {            \n"
"            $user = new User($matches[1]);\n"
"            return Result::success($user);        \n"
"        }       \n"
"\n"
"        return Result::fail();\n"
"    }\n"
"}\n"
"\n"
"final class Post\n"
"{\n"
"    public function __construct(\n"
"        private string $title,\n"
"        private User $author\n"
"    )\n"
"    {    \n"
"    }\n"
"    \n"
"    public function getTitle(): string \n"
"    {\n"
"        return $this->title;    \n"
"    }\n"
"    \n"
"    public function getAuthor(): User\n"
"    {\n"
"        return $this->author;\n"
"    }\n"
"}\n"
"\n"
"$typeCaster = new CompositeTypeCaster(\n"
"    // ...\n"
"    new NickNameTypeCaster(),\n"
");\n"
"$hydrator = new Hydrator($typeCaster);\n"
"\n"
"$post = $hydrator->create(Post::class, ['title' => 'Example post', 'author' => '@samdark']);\n"
"echo $post->getAuthor()->getNickName();\n"
msgstr ""
"use Yiisoft\\Hydrator\\TypeCaster\\TypeCastContext;\n"
"use Yiisoft\\Hydrator\\TypeCaster\\TypeCasterInterface;\n"
"use Yiisoft\\Hydrator\\Result;\n"
"use Yiisoft\\Hydrator\\Hydrator;\n"
"use Yiisoft\\Hydrator\\TypeCaster\\CompositeTypeCaster;\n"
"\n"
"final class User\n"
"{\n"
"    public function __construct(\n"
"        private string $nickname\n"
"    )\n"
"    {\n"
"    }\n"
"    \n"
"    public function getNickName(): string\n"
"    {\n"
"        return $this->nickname;\n"
"    }\n"
"}\n"
"\n"
"final class NickNameTypeCaster implements TypeCasterInterface\n"
"{\n"
"    public function cast(mixed $value, TypeCastContext $context): Result\n"
"    {\n"
"        $type = $context->getReflectionType();\n"
"    \n"
"        if (\n"
"            $context->getReflection()->getName() === 'author'\n"
"            && $type instanceof ReflectionNamedType\n"
"            && $type->isBuiltin()\n"
"            && $type->getName() === 'string'\n"
"            && preg_match('~^@(.*)$~', $value, $matches)\n"
"        ) {            \n"
"            $user = new User($matches[1]);\n"
"            return Result::success($user);        \n"
"        }       \n"
"\n"
"        return Result::fail();\n"
"    }\n"
"}\n"
"\n"
"final class Post\n"
"{\n"
"    public function __construct(\n"
"        private string $title,\n"
"        private User $author\n"
"    )\n"
"    {    \n"
"    }\n"
"    \n"
"    public function getTitle(): string \n"
"    {\n"
"        return $this->title;    \n"
"    }\n"
"    \n"
"    public function getAuthor(): User\n"
"    {\n"
"        return $this->author;\n"
"    }\n"
"}\n"
"\n"
"$typeCaster = new CompositeTypeCaster(\n"
"    // ...\n"
"    new NickNameTypeCaster(),\n"
");\n"
"$hydrator = new Hydrator($typeCaster);\n"
"\n"
"$post = $hydrator->create(Post::class, ['title' => 'Example post', 'author' => '@samdark']);\n"
"echo $post->getAuthor()->getNickName();\n"

#. type: Title ###
#: guide/en/typecasting.md
#, no-wrap
msgid "`ToString`"
msgstr "`ToString`"

#. type: Plain text
#: guide/en/typecasting.md
msgid "To cast a value to string explicitly, you can use `ToString` attribute:"
msgstr "Para converter um valor para string explicitamente, você pode usar o atributo `ToString`:"

#. type: Fenced code block (php)
#: guide/en/typecasting.md
#, no-wrap
msgid ""
"use \\Yiisoft\\Hydrator\\Attribute\\Parameter\\ToString;\n"
"\n"
"class Money\n"
"{\n"
"    public function __construct(\n"
"        #[ToString]\n"
"        private string $value,\n"
"        private string $currency,\n"
"    ) {}\n"
"}\n"
"\n"
"$money = $hydrator->create(Money::class, [\n"
"    'value' => 4200,\n"
"    'currency' => 'AMD',\n"
"]);\n"
msgstr ""
"use \\Yiisoft\\Hydrator\\Attribute\\Parameter\\ToString;\n"
"\n"
"class Money\n"
"{\n"
"    public function __construct(\n"
"        #[ToString]\n"
"        private string $value,\n"
"        private string $currency,\n"
"    ) {}\n"
"}\n"
"\n"
"$money = $hydrator->create(Money::class, [\n"
"    'value' => 4200,\n"
"    'currency' => 'AMD',\n"
"]);\n"

#. type: Title ###
#: guide/en/typecasting.md
#, no-wrap
msgid "`Trim` / `LeftTrim` / `RightTrim`"
msgstr "`Trim` / `LeftTrim` / `RightTrim`"

#. type: Plain text
#: guide/en/typecasting.md
msgid "To strip whitespace (or other characters) from the beginning and/or end of a resolved string value, you can use `Trim`, `LeftTrim` or `RightTrim` attributes:"
msgstr "Para remover espaços em branco (ou outros caracteres) do início e/ou final de um valor de string resolvido, você pode usar os atributos `Trim`, `LeftTrim` ou `RightTrim`:"

#. type: Fenced code block (php)
#: guide/en/typecasting.md
#, no-wrap
msgid ""
"use DateTimeImmutable;\n"
"use Yiisoft\\Hydrator\\Attribute\\Parameter\\Trim;\n"
"\n"
"class Person\n"
"{\n"
"    public function __construct(\n"
"        #[Trim] // '  John ' → 'John'\n"
"        private ?string $name = null, \n"
"    ) {}\n"
"}\n"
"\n"
"$person = $hydrator->create(Person::class, ['name' => '  John ']);\n"
msgstr ""
"use DateTimeImmutable;\n"
"use Yiisoft\\Hydrator\\Attribute\\Parameter\\Trim;\n"
"\n"
"class Person\n"
"{\n"
"    public function __construct(\n"
"        #[Trim] // '  John ' → 'John'\n"
"        private ?string $name = null, \n"
"    ) {}\n"
"}\n"
"\n"
"$person = $hydrator->create(Person::class, ['name' => '  John ']);\n"

#. type: Plain text
#: guide/en/typecasting.md
msgid "By default, these attributes are not multibyte-aware, so Unicode whitespace characters, such as `U+00A0` (no-break space) or `U+2003` (em space), are kept. To strip them as well, enable the `multibyte` parameter:"
msgstr ""

#. type: Fenced code block (php)
#: guide/en/typecasting.md
#, fuzzy, no-wrap
msgid ""
"use Yiisoft\\Hydrator\\Attribute\\Parameter\\Trim;\n"
"\n"
"class Person\n"
"{\n"
"    public function __construct(\n"
"        #[Trim(multibyte: true)] // \"\\u{A0}John\\u{2003}\" → 'John'\n"
"        private ?string $name = null,\n"
"    ) {}\n"
"}\n"
"\n"
"$person = $hydrator->create(Person::class, ['name' => \"\\u{A0}John\\u{2003}\"]);\n"
msgstr ""
"use DateTimeImmutable;\n"
"use Yiisoft\\Hydrator\\Attribute\\Parameter\\Trim;\n"
"\n"
"class Person\n"
"{\n"
"    public function __construct(\n"
"        #[Trim] // '  John ' → 'John'\n"
"        private ?string $name = null, \n"
"    ) {}\n"
"}\n"
"\n"
"$person = $hydrator->create(Person::class, ['name' => '  John ']);\n"

#. type: Plain text
#: guide/en/typecasting.md
msgid "Multibyte mode uses `mb_trim()`, `mb_ltrim()` and `mb_rtrim()` functions that are provided by `mbstring` PHP extension since PHP 8.4. To use it with an earlier PHP version, install [symfony/polyfill-mbstring](https://github.com/symfony/polyfill-mbstring) package. The `encoding` parameter selects the encoding used in multibyte mode; `null` (default) means using `mb_internal_encoding()`."
msgstr ""

#. type: Plain text
#: guide/en/typecasting.md
msgid "With `..` you can specify a range of characters in the `characters` parameter, for example, `а..я`. It works both in the default and in the multibyte mode. This syntax is deprecated and will be removed in the next major version, so avoid it in new code."
msgstr ""

#. type: Title ###
#: guide/en/typecasting.md
#, no-wrap
msgid "`ToDatetime`"
msgstr "`ToDatetime`"

#. type: Plain text
#: guide/en/typecasting.md
msgid "To cast a value to `DateTimeImmutable` or `DateTime` object explicitly, you can use `ToDateTime` attribute:"
msgstr "Para converter um valor para o objeto `DateTimeImmutable` ou `DateTime` explicitamente, você pode usar o atributo `ToDateTime`:"

#. type: Fenced code block (php)
#: guide/en/typecasting.md
#, no-wrap
msgid ""
"use DateTimeImmutable;\n"
"use Yiisoft\\Hydrator\\Attribute\\Parameter\\ToDateTime;\n"
"\n"
"class Person\n"
"{\n"
"    public function __construct(\n"
"        #[ToDateTime(locale: 'ru')]\n"
"        private ?DateTimeImmutable $birthday = null,\n"
"    ) {}\n"
"}\n"
"\n"
"$person = $hydrator->create(Person::class, ['birthday' => '27.01.1986']);\n"
msgstr ""
"use DateTimeImmutable;\n"
"use Yiisoft\\Hydrator\\Attribute\\Parameter\\ToDateTime;\n"
"\n"
"class Person\n"
"{\n"
"    public function __construct(\n"
"        #[ToDateTime(locale: 'ru')]\n"
"        private ?DateTimeImmutable $birthday = null,\n"
"    ) {}\n"
"}\n"
"\n"
"$person = $hydrator->create(Person::class, ['birthday' => '27.01.1986']);\n"

#. type: Title ###
#: guide/en/typecasting.md
#, no-wrap
msgid "`Collection`"
msgstr "`Collection`"

#. type: Plain text
#: guide/en/typecasting.md
msgid "Hydrator supports collections via `Collection` attribute. The class name of related collection must be specified:"
msgstr "O hydrator suporta coleções através do atributo `Collection`. O nome da classe da coleção relacionada deve ser especificado:"

#. type: Fenced code block (php)
#: guide/en/typecasting.md
#, no-wrap
msgid ""
"final class PostCategory\n"
"{\n"
"    public function __construct(\n"
"        #[Collection(Post::class)]\n"
"        private array $posts = [],\n"
"    ) {\n"
"    }\n"
"}\n"
"\n"
"final class Post\n"
"{\n"
"    public function __construct(\n"
"        private string $name,\n"
"        private string $description = '',\n"
"    ) {\n"
"    }\n"
"}\n"
"\n"
"$category = $hydrator->create(\n"
"    PostCategory::class,\n"
"    [\n"
"        'posts' => [\n"
"            ['name' => 'Post 1'],\n"
"            ['name' => 'Post 2', 'description' => 'Description for post 2'],\n"
"        ],\n"
"    ],\n"
");\n"
msgstr ""
"final class PostCategory\n"
"{\n"
"    public function __construct(\n"
"        #[Collection(Post::class)]\n"
"        private array $posts = [],\n"
"    ) {\n"
"    }\n"
"}\n"
"\n"
"final class Post\n"
"{\n"
"    public function __construct(\n"
"        private string $name,\n"
"        private string $description = '',\n"
"    ) {\n"
"    }\n"
"}\n"
"\n"
"$category = $hydrator->create(\n"
"    PostCategory::class,\n"
"    [\n"
"        'posts' => [\n"
"            ['name' => 'Post 1'],\n"
"            ['name' => 'Post 2', 'description' => 'Description for post 2'],\n"
"        ],\n"
"    ],\n"
");\n"

#. type: Title ###
#: guide/en/typecasting.md
#, no-wrap
msgid "`ToArrayOfStrings`"
msgstr "`ToArrayOfStrings`"

#. type: Plain text
#: guide/en/typecasting.md
msgid "Use `ToArrayOfStrings` attribute to cast a value to an array of strings:"
msgstr "Use o atributo `ToArrayOfStrings` para converter um valor em um array de strings:"

#. type: Fenced code block (php)
#: guide/en/typecasting.md
#, no-wrap
msgid ""
"use Yiisoft\\Hydrator\\Attribute\\Parameter\\ToArrayOfStrings;\n"
"\n"
"final class Post\n"
"{\n"
"    #[ToArrayOfStrings(separator: ',')]\n"
"    public array $tags = [];    \n"
"}\n"
msgstr ""
"use Yiisoft\\Hydrator\\Attribute\\Parameter\\ToArrayOfStrings;\n"
"\n"
"final class Post\n"
"{\n"
"    #[ToArrayOfStrings(separator: ',')]\n"
"    public array $tags = [];    \n"
"}\n"

#. type: Plain text
#: guide/en/typecasting.md
msgid "Value of `tags` will be cast to an array of strings by splitting it by `,`. For example, string `news,city,hot` will be converted to array `['news', 'city', 'hot']`."
msgstr "O valor de `tags` será convertido em um array de strings dividindo-o por `,`. Por exemplo, a string `news,city,hot` será convertida no array `['news', 'city', 'hot']`."

#. type: Plain text
#: guide/en/typecasting.md
msgid "Attribute parameters:"
msgstr "Parâmetros do atributo:"

#. type: Bullet: '- '
#: guide/en/typecasting.md
msgid "`trim` — trim each string of array (boolean, default `false`);"
msgstr "`trim` — remove os espaços em branco do início e do final de cada string do array (booleano, padrão `false`);"

#. type: Bullet: '- '
#: guide/en/typecasting.md
msgid "`removeEmpty` — remove empty strings from array (boolean, default `false`);"
msgstr "`removeEmpty` — remove as strings vazias do array (booleano, padrão `false`);"

#. type: Bullet: '- '
#: guide/en/typecasting.md
msgid "`splitResolvedValue` — split resolved value by separator (boolean, default `true`);"
msgstr "`splitResolvedValue` — divide o valor resolvido pelo separador (booleano, padrão `true`);"

#. type: Bullet: '- '
#: guide/en/typecasting.md
#, fuzzy
msgid "`separator` — the boundary string (default, `\\R`), it's a part of regular expression so should be taken into account or properly escaped with `preg_quote()`;"
msgstr "`separator` — a string delimitadora (padrão, `\\R`), faz parte de uma expressão regular, portanto deve ser levada em conta ou devidamente escapada com `preg_quote()`."

#. type: Bullet: '- '
#: guide/en/typecasting.md
msgid "`multibyte` — whether to use multibyte-aware trimming when `trim` is enabled (nullable boolean, default `null` meaning the resolver default is used); requires the `mb_trim()` function provided by `mbstring` PHP extension since PHP 8.4, or by [symfony/polyfill-mbstring](https://github.com/symfony/polyfill-mbstring) package on earlier versions;"
msgstr ""

#. type: Bullet: '- '
#: guide/en/typecasting.md
msgid "`encoding` — the encoding to use in multibyte mode (nullable string, default `null` meaning the resolver default is used)."
msgstr ""
